{
  "name": "virtude",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3210",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3210",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:db": "node --import tsx scripts/test-database.ts",
    "db:apply": "node --import tsx scripts/apply-db.ts",
    "cf:build": "opennextjs-cloudflare build",
    "cf:deploy": "opennextjs-cloudflare build && wrangler deploy",
    "content:seed": "node --import tsx scripts/seed-content.ts",
    "security:secrets": "secretlint \"src/**/*.{ts,tsx,css}\" \"db/**/*.sql\" \".env.example\" \"next.config.ts\"",
    "security:sast": "uvx --python 3.12 --from semgrep==1.182.1 semgrep scan --config security/semgrep.yml --config p/security-audit --error --metrics=off --no-git-ignore src",
    "security:bundle": "node --import tsx scripts/check-client-bundle.ts"
  },
  "dependencies": {
    "@fontsource/cormorant-garamond": "5.3.0",
    "@fontsource/dm-sans": "5.3.0",
    "bcryptjs": "^3.0.3",
    "clsx": "2.1.1",
    "lucide-react": "1.62.0",
    "next": "^16.4.5",
    "next-auth": "^5.0.0-beta.32",
    "postgres": "^4.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@electric-sql/pglite": "0.5.12",
    "@opennextjs/cloudflare": "^1.20.16",
    "@playwright/test": "1.64.1",
    "@secretlint/secretlint-rule-preset-recommend": "13.1.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "^16.4.5",
    "secretlint": "13.1.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.5",
    "wrangler": "^4.158.0"
  },
  "type": "module"
}
