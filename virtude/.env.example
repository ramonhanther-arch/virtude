# Copie para .env.local. Nunca comite valores reais.
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3210
# Neon pooled (local e scripts). Em Workers, o Hyperdrive preenche isto no entrypoint.
DATABASE_URL=
# Auth.js. Pelo menos 32 caracteres aleatórios. AUTH_URL é a origem pública do app.
AUTH_SECRET=
AUTH_URL=http://127.0.0.1:3210
OPENAI_API_KEY=
# Escolha um modelo com Structured Outputs disponível na sua conta.
OPENAI_MODEL=gpt-4.1-mini
# Impede publicação de conteúdo ainda não aprovado. Só habilitar em desenvolvimento.
ALLOW_UNREVIEWED_CONTENT=false
# Segredo aleatório do servidor para hash de IP no rate limit de autenticação.
AUTH_RATE_LIMIT_SECRET=
# Só habilitar quando o ingress sobrescreve x-real-ip e impede acesso direto à origem.
TRUST_AUTH_PROXY=false
# E-mails da equipe editorial, separados por vírgula. Também vale users.role = admin.
# Não aprove missões por script. O painel /app/revisao grava o parecer no Postgres.
VIRTUDE_CONTENT_REVIEWERS=
# Segredo do endpoint POST /api/cron/reminders. O envio de e-mail ainda é um stub.
CRON_SECRET=
# Id do Hyperdrive depois de criá-lo no Cloudflare. O placeholder está no wrangler.toml.
# HYPERDRIVE_ID=
